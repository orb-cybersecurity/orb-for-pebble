<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8 to 11: whole databases (including notification, network and action history),
     shared preferences, and all files/pbw/ contents (store and sideloaded PBWs and PKJS).
     See data_extraction_rules.xml for backup size and encryption details. -->
<full-backup-content>
    <include domain="database" path="." requireFlags="clientSideEncryption" />
    <include domain="sharedpref" path="." requireFlags="clientSideEncryption" />
    <include domain="file" path="pbw/" requireFlags="clientSideEncryption" />
</full-backup-content>
