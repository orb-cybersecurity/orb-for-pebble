<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android's backup may copy, from Android 12 on. Seedvault, GrapheneOS's backup, uses the
  device-transfer rules; other backup services use cloud-backup, and only when they encrypt on
  the phone.

  Included: whole databases, including watches, locker entries, notification history,
  health/settings data, permission answers, per-app network usage and plugin-action history;
  all shared preferences, including the Rebble sign-in; and everything in files/pbw/.
  That directory holds both store and sideloaded PBWs and extracted PKJS files. Its store
  PBWs are a cache in use, but are included in backup. cache/ and logs there are excluded.
  Backup size depends on those files and histories and may exceed a service's quota.

  A plugin's secrets are encrypted under a key that stays on the phone that wrote them, so a
  restored copy can't be read; Orb discards them and the plugin asks again.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="pbw/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="pbw/" />
    </device-transfer>
</data-extraction-rules>
